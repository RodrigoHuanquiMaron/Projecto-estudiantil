# 1) Copia este archivo y renómbralo a:  .env
# 2) Pega aquí tus datos reales. El archivo .env NUNCA se sube a GitHub.

PORT=3000
NODE_ENV=development

# PostgreSQL: pega la "External Database URL" de tu base en Render
# (o tu base local: postgresql://postgres:TU_CLAVE@localhost:5432/masterestudio)
DATABASE_URL=

# Redis (opcional en tu PC). Si lo dejas vacío, las sesiones se guardan en memoria
# y la caché se desactiva. En Render se llena automáticamente.
REDIS_URL=

# Cualquier texto largo y secreto
SESSION_SECRET=cambia-esto-por-un-texto-largo-y-secreto
