<%- include('partials/head', { bodyClass: 'auth-body' }) %>
<main class="auth">
  <section class="auth-hero">
    <div class="auth-photo"></div>
    <h2>Tu plataforma de rendimiento estudiantil</h2>
    <p>Crea tu cuenta y te inscribimos en los cursos del ciclo.</p>
  </section>
  <section class="auth-panel">
    <div class="auth-top"><%- include('partials/logo') %><span class="lang">ES</span></div>
    <div class="auth-form-wrap">
      <h1>Crea tu cuenta</h1>
      <p class="muted">Solo toma un minuto.</p>
      <form action="/registro" method="post" class="form">
        <label for="nombre">Nombre completo</label>
        <input id="nombre" name="nombre" required minlength="3" autocomplete="name" placeholder="Alan García">
        <label for="email">Correo electrónico</label>
        <input id="email" name="email" type="email" required autocomplete="email" placeholder="tu_correo@usmp.pe">
        <label for="password">Contraseña</label>
        <div class="input-pass">
          <input id="password" name="password" type="password" required minlength="6" autocomplete="new-password" placeholder="Mínimo 6 caracteres">
          <button type="button" class="toggle-pass" data-toggle-pass aria-label="Mostrar contraseña">👁</button>
        </div>
        <button class="btn btn-primary btn-block" type="submit">Crear cuenta</button>
      </form>
    </div>
    <p class="auth-foot">¿Ya tienes cuenta? <a href="/login" class="link">Inicia sesión</a></p>
  </section>
</main>
<%- include('partials/flash') %>
<%- include('partials/foot', { sinSocket: true }) %>
