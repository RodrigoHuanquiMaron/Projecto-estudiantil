<%- include('partials/head') %>
<%- include('partials/navbar') %>
<main class="page narrow">
  <a href="/cursos" class="link small">← Volver a Mis cursos</a>
  <div class="detail card">
    <%- include('partials/art', { curso: curso }) %>
    <div class="detail-body">
      <div class="card-meta">
        <span><%= curso.categoria %> · <%= curso.creditos %> créditos</span>
        <span class="badge <%= curso.estado %>"><%= h.estado(curso.estado) %></span>
      </div>
      <h1><%= curso.nombre %></h1>
      <p class="muted">Instructor: <%= curso.instructor %></p>
      <%- include('partials/progress', { curso: curso }) %>
      <p class="muted small">Tiempo estudiado en este curso: <b><%= Math.round(estudio.min / 6) / 10 %> hrs</b> en <%= estudio.sesiones %> sesiones.</p>
    </div>
  </div>

  <div class="grid-2">
    <form class="card form" action="/cursos/<%= curso.id %>/progreso" method="post">
      <h3>Registrar avance</h3>
      <label for="progreso">Progreso del curso (%)</label>
      <input id="progreso" name="progreso" type="number" min="0" max="100" value="<%= curso.progreso %>" required>
      <label for="nota">Nota actual (0–100, opcional)</label>
      <input id="nota" name="nota" type="number" step="0.1" min="0" max="100" value="<%= curso.nota !== null ? curso.nota : '' %>">
      <button class="btn btn-primary" type="submit">Guardar avance</button>
    </form>

    <div class="card" id="materiales">
      <h3>Materiales</h3>
      <ul class="materials">
        <li>📄 Sílabo del curso</li>
        <li>📊 Diapositivas · Semanas 1 a 8</li>
        <li>📝 Guía de ejercicios resueltos</li>
        <li>🎥 Grabaciones de clase</li>
      </ul>
      <a class="btn btn-outline btn-sm" href="/estudio">Estudiar este curso</a>
    </div>
  </div>
</main>
<%- include('partials/flash') %>
<%- include('partials/foot') %>
